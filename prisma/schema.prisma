
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  password  String
  role      String    @default("EMPLOYEE")
  orders    Order[]
  payments  Payment[]
  createdAt DateTime  @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  phone     String?
  phone2    String?
  address   String?
  source    String    @default("ADMIN")
  orders    Order[]
  payments  Payment[]
}

model Product {
  id               String      @id @default(cuid())
  modelNo          String
  description      String?
  material         String?
  color            String
  stockQty         Int         @default(0)
  currentStock     Int         @default(0)
  price            Float
  discount         Float       @default(0.0)
  status           String      @default("OPEN") 

  isStockAlertRead Boolean     @default(false)

  orderItems       OrderItem[]

  @@unique([modelNo, color])
}

model Safe {
  id                String    @id @default(cuid())
  name              String
  orders            Order[]
  payments          Payment[] @relation("SourceSafe")
  incomingTransfers Payment[] @relation("TargetSafe")
  createdAt         DateTime  @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNo     Int         @default(autoincrement())
  createdAt   DateTime    @default(now())

  deposit     Float       @default(0.0)
  currency    String      @default("EGP")
  discount    Float       @default(0.0) 

  totalAmount Float
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  safeId      String?
  safe        Safe?       @relation(fields: [safeId], references: [id])
  items       OrderItem[]
  notes       String?
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int     
  fulfilledQty    Int     @default(0) 
  price           Float
  discountPercent Int     @default(0)
  isPostponed     Boolean @default(false)

  logs            FulfillmentLog[]
}

model FulfillmentLog {
  id          String   @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int       
  batchId     String    
  createdAt   DateTime  @default(now())
}

model Payment {
  id           String   @id @default(cuid())
  receiptNo    Int      @default(autoincrement())
  createdAt    DateTime @default(now())
  amount       Float
  currency     String   @default("EGP") 

  type         String   @default("IN") 
  description  String?  

  customerId   String?  
  customer     Customer? @relation(fields: [customerId], references: [id])

  userId       String
  user         User     @relation(fields: [userId], references: [id])

  safeId       String   
  safe         Safe     @relation("SourceSafe", fields: [safeId], references: [id])

  targetSafeId String?  
  targetSafe   Safe?    @relation("TargetSafe", fields: [targetSafeId], references: [id])
}

model WarehouseReceipt {
  uniqueid String   @id             
  date     DateTime                 
  empName  String                   
  modelNo  String                   
  most     Int                      

  @@index([modelNo])                
  @@index([date])                   
}

model Settings {
  id           String  @id @default(cuid())
  siteName     String?
  invoiceNotes String?
  header       String?
  footer       String?
}

model Job {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      String
  status    String   @default("PENDING")
  payload   Json?
  result    Json?

  @@index([type, status])
}
