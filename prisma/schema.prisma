generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  password  String
  role      String    @default("EMPLOYEE")
  orders    Order[]
  payments  Payment[]
  createdAt DateTime  @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  phone     String?
  phone2    String?
  address   String?
  source    String    @default("ADMIN") // 👈 تم الإضافة: ADMIN (إكسيل) أو QUICK (بيع)
  orders    Order[]
  payments  Payment[]
}

model Product {
  id          String      @id @default(cuid())
  modelNo     String
  description String?
  material    String?
  color       String
  stockQty    Int         @default(0)
  price       Float
  status      String      @default("OPEN") 
  orderItems  OrderItem[]

  @@unique([modelNo, color])
}

model Safe {
  id              String    @id @default(cuid())
  name            String
  orders          Order[]
  payments        Payment[] @relation("SourceSafe")
  incomingTransfers Payment[] @relation("TargetSafe") // 👈 علاقة عكسية للتحويلات الواردة
  createdAt       DateTime  @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNo     Int         @default(autoincrement())
  createdAt   DateTime    @default(now())
  
  deposit     Float       @default(0.0)
  discount    Float       @default(0.0) 

  totalAmount Float
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  safeId      String?
  safe        Safe?       @relation(fields: [safeId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  price           Float
  discountPercent Int     @default(0)
}

model Payment {
  id           String   @id @default(cuid())
  receiptNo    Int      @default(autoincrement())
  createdAt    DateTime @default(now())
  amount       Float
  currency     String   @default("EGP") // 👈 تم الإضافة: العملة (EGP, USD, SAR, KWD)
  
  // 👇 التعديلات السابقة
  type         String   @default("IN") // قيم محتملة: IN (قبض), OUT (صرف), TRANSFER (تحويل)
  description  String?  // وصف للمصروف أو التحويل
  
  customerId   String?  // 👈 أصبح اختياري
  customer     Customer? @relation(fields: [customerId], references: [id])
  
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  safeId       String   // الخزنة المصدر (أو التي تم القبض فيها)
  safe         Safe     @relation("SourceSafe", fields: [safeId], references: [id])

  targetSafeId String?  // 👈 الخزنة المستلمة (في حالة التحويل فقط)
  targetSafe   Safe?    @relation("TargetSafe", fields: [targetSafeId], references: [id])
}