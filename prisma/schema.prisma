// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  password  String
  role      String    @default("EMPLOYEE")
  orders    Order[]
  payments  Payment[]
  createdAt DateTime  @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  phone     String?
  phone2    String?
  address   String?
  source    String    @default("ADMIN")
  orders    Order[]
  payments  Payment[]
}

model Product {
  id           String      @id @default(cuid())
  modelNo      String
  description  String?
  material     String?
  color        String
  stockQty     Int         @default(0) // الرصيد الافتتاحي (ثابت)
  currentStock Int         @default(0) // 👈 الرصيد الحالي الفعلي (جديد)
  price        Float
  discount     Float       @default(0.0)
  status       String      @default("OPEN") 
  orderItems   OrderItem[]

  @@unique([modelNo, color])
}

model Safe {
  id                String    @id @default(cuid())
  name              String
  orders            Order[]
  payments          Payment[] @relation("SourceSafe")
  incomingTransfers Payment[] @relation("TargetSafe")
  createdAt         DateTime  @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNo     Int         @default(autoincrement())
  createdAt   DateTime    @default(now())
  
  deposit     Float       @default(0.0)
  currency    String      @default("EGP")
  discount    Float       @default(0.0) 

  totalAmount Float
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  safeId      String?
  safe        Safe?       @relation(fields: [safeId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  price           Float
  discountPercent Int     @default(0)
}

model Payment {
  id           String   @id @default(cuid())
  receiptNo    Int      @default(autoincrement())
  createdAt    DateTime @default(now())
  amount       Float
  currency     String   @default("EGP") 
  
  type         String   @default("IN") 
  description  String?  
  
  customerId   String?  
  customer     Customer? @relation(fields: [customerId], references: [id])
  
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  safeId       String   
  safe         Safe     @relation("SourceSafe", fields: [safeId], references: [id])

  targetSafeId String?  
  targetSafe   Safe?    @relation("TargetSafe", fields: [targetSafeId], references: [id])
}